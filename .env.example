# Get a free key at https://aistudio.google.com/apikey
# Server-only: never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the Live API model (must support the Live API / bidiGenerateContent)
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
# Optional: prebuilt voice (Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr)
# GEMINI_VOICE=Puck
# Optional: how long (ms) of silence ends your turn. Lower = snappier replies, but may cut you off mid-pause.
# GEMINI_SILENCE_MS=300
